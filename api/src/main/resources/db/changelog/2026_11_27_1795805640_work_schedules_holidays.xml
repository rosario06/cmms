<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="1795805640-1" author="Atlas">
        <createTable tableName="work_schedule">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="company_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="timezone" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="default_schedule" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="work_schedule" baseColumnNames="company_id" constraintName="fk_work_schedule_company_id" referencedTableName="company" referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="work_schedule" indexName="idx_work_schedule_company"><column name="company_id"/></createIndex>
        <createSequence sequenceName="work_schedule_seq" startValue="1" incrementBy="50"/>
    </changeSet>

    <changeSet id="1795805640-2" author="Atlas">
        <createTable tableName="work_schedule_shift">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="company_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="schedule_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="day_of_week" type="INTEGER"><constraints nullable="false"/></column>
            <column name="start_time" type="TIME"><constraints nullable="false"/></column>
            <column name="end_time" type="TIME"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="work_schedule_shift" baseColumnNames="company_id" constraintName="fk_work_schedule_shift_company_id" referencedTableName="company" referencedColumnNames="id" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="work_schedule_shift" baseColumnNames="schedule_id" constraintName="fk_work_schedule_shift_schedule_id" referencedTableName="work_schedule" referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="work_schedule_shift" indexName="idx_work_schedule_shift_schedule"><column name="schedule_id"/></createIndex>
        <createSequence sequenceName="work_schedule_shift_seq" startValue="1" incrementBy="50"/>
    </changeSet>

    <!-- work_schedule_id is nullable (null = holiday of every schedule of the company) but the FK is CASCADE on
         purpose: SET NULL would silently turn the holidays of a deleted schedule into company-wide holidays -->
    <changeSet id="1795805640-3" author="Atlas">
        <createTable tableName="holiday">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="company_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="holiday_date" type="DATE"><constraints nullable="false"/></column>
            <column name="recurring_annually" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="work_schedule_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="holiday" baseColumnNames="company_id" constraintName="fk_holiday_company_id" referencedTableName="company" referencedColumnNames="id" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="holiday" baseColumnNames="work_schedule_id" constraintName="fk_holiday_work_schedule_id" referencedTableName="work_schedule" referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="holiday" indexName="idx_holiday_company_date"><column name="company_id"/><column name="holiday_date"/></createIndex>
        <createSequence sequenceName="holiday_seq" startValue="1" incrementBy="50"/>
    </changeSet>

    <changeSet id="1795805640-4" author="Atlas">
        <addColumn tableName="own_user">
            <column name="work_schedule_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="own_user" baseColumnNames="work_schedule_id" constraintName="fk_own_user_work_schedule_id" referencedTableName="work_schedule" referencedColumnNames="id" onDelete="SET NULL"/>
        <addColumn tableName="sla_policy">
            <column name="use_business_hours" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="work_schedule_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="sla_policy" baseColumnNames="work_schedule_id" constraintName="fk_sla_policy_work_schedule_id" referencedTableName="work_schedule" referencedColumnNames="id" onDelete="SET NULL"/>
    </changeSet>
</databaseChangeLog>
